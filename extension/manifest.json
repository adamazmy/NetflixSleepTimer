{
  "manifest_version": 3,
  "name": "Netflix Sleep Timer",
  "version": "1.0.0",
  "description": "Adds a sleep timer button to the Netflix player: fades the sound, pauses, then sleeps / turns off the screen / shuts down the PC.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
